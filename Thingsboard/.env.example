# ThingsBoard MQTT broker
TB_MQTT_HOST=your-thingsboard-host
TB_MQTT_PORT=1883

# Optional: if set, this access token is used directly and provisioning is skipped.
# Leave blank to provision a new device on first run.
TB_ACCESS_TOKEN=

# Stable, UNIQUE name per bell tower (one Pycom + ESP32 pair = one TB device).
# Required when provisioning (i.e. when no token is set or cached).
TB_DEVICE_NAME=belltower-0001

# Device Profile provisioning credentials ("Allow to create new devices").
# Shared across all towers of the same profile. Do NOT commit real values.
TB_PROVISION_DEVICE_KEY=your-provision-device-key
TB_PROVISION_DEVICE_SECRET=your-provision-device-secret

# Where the obtained access token is cached so the device never re-provisions.
TB_TOKEN_FILE=.tb_token
